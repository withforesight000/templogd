#!lua name=mylib
redis.register_function('{{ function_name }}', function(keys, args)
    local stream_key   = keys[1]
    local start_id     = args[1]
    local end_id       = args[2]
    local sample_count = tonumber(args[3])
    local result = {}

    -- Fetch all entries in range with a single XRANGE call
    local all_entries = redis.call('XRANGE', stream_key, start_id, end_id)
    local total_count = #all_entries
    
    -- If total entries are less than or equal to requested samples, return all
    if total_count <= sample_count then
        return all_entries
    end

    -- Calculate sampling step for uniform distribution
    local step = total_count / sample_count
    
    -- Sample entries uniformly across the range
    for i = 0, sample_count - 1 do
        local idx = math.floor(i * step) + 1
        if idx <= total_count then
            table.insert(result, all_entries[idx])
        end
    end

    return result
end)
